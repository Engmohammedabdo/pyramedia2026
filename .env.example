# Copy to .env and fill in. All keys are optional — the site degrades gracefully
# when a key is missing (see SPEC.md §14).

# Canonical site URL (no trailing slash)
PUBLIC_SITE_URL=https://pyramedia.info

# TODO_N8N_WEBHOOK: n8n form webhook URL. While empty, the contact form renders
# a disabled state with a WhatsApp fallback.
PUBLIC_N8N_WEBHOOK_URL=

# TODO_GA4_ID: GA4 measurement ID (G-XXXXXXXXXX). While empty, GA4 is not injected.
PUBLIC_GA4_ID=

# TODO_META_PIXEL_ID: Meta Pixel ID. While empty, the Pixel is not injected.
PUBLIC_META_PIXEL_ID=
