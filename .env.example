# Copy to .env and fill in. All keys are optional — the site degrades gracefully
# when a key is missing (see SPEC.md §14).

# Canonical site URL (no trailing slash)
PUBLIC_SITE_URL=https://pyramedia.info

# TODO_N8N_WEBHOOK: n8n form webhook URL. While empty, the contact form renders
# a disabled state with a WhatsApp fallback.
PUBLIC_N8N_WEBHOOK_URL=

# TODO_N8N_AUDIT_URL: n8n instant-audit webhook URL (Feature 2, workflow
# "PyramediaX — Instant Audit"). While empty, the audit route renders its
# WhatsApp fallback instead of a form that cannot run.
PUBLIC_N8N_AUDIT_URL=

# Instagram audit mode costs an Apify run per scan — off until the owner
# approves that budget. Website audits are free and always available.
# Set to "true" to enable. Anything else (including empty) stays disabled.
PUBLIC_AUDIT_INSTAGRAM=

# TODO_GA4_ID: GA4 measurement ID (G-XXXXXXXXXX). While empty, GA4 is not injected.
PUBLIC_GA4_ID=

# TODO_META_PIXEL_ID: Meta Pixel ID. While empty, the Pixel is not injected.
PUBLIC_META_PIXEL_ID=

# TODO_TIKTOK_PIXEL_ID: TikTok Pixel ID (SPEC Addendum A.4). While empty, the
# Pixel is not injected.
PUBLIC_TIKTOK_PIXEL_ID=
