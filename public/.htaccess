# ────────────────────────────────────────────────────────────────────
# PyramediaX — Apache config (SPEC §13.2)
# Deployed to the site root together with the static build.
#
# ⚠ THIS FILE IS INHERITED BY NESTED SUBDOMAINS.
# The live host keeps several subdomain document roots INSIDE public_html
# (card → website_3ffc80b5, clinic, stock, aiagent, new …), and most of them
# ship no .htaccess of their own. Anything left unscoped here is applied to
# them too. Unscoped, this file would have 301-redirected every one of those
# hosts to pyramedia.info — including the card showcases the site links to —
# and would have broken their PHP index pages via DirectoryIndex.
#
# So: everything host-specific is fenced. Rewrites exit early for foreign
# hosts; headers are gated on the MAINSITE env; ErrorDocument sits inside an
# <If> (verified supported on this server). DirectoryIndex deliberately keeps
# index.php as a fallback so nested PHP apps still resolve their homepage.
# ────────────────────────────────────────────────────────────────────
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

SetEnvIf Host "^(www\.)?pyramedia\.info$" MAINSITE

<If "%{HTTP_HOST} =~ /^(www\.)?pyramedia\.info$/i">
  ErrorDocument 404 /404.html

  # The build emits services.html BESIDE a services/ folder, in both
  # languages. mod_dir sees the folder and 301s /services → /services/ before
  # the rewrites below ever run — verified live, it fought the trailing-slash
  # rule and produced a redirect loop. Off, so the .html twin wins. Real
  # asset folders are not linked as URLs and Options -Indexes still covers
  # them. Host-scoped: subdomains keep Apache's default behaviour.
  DirectorySlash Off

  # public/ is Laravel's own web root and carries its OWN .htaccess with
  # RewriteEngine On, which discards every rewrite inherited from here — the
  # same inheritance rule that protects the subdomains works against us here,
  # so `RewriteRule ^public …` was silently ignored and /public/index.php
  # still 302'd into the old site. mod_alias is a different module and is not
  # overridden by the child's mod_rewrite block, so it wins.
  RedirectMatch 403 ^/public(/|$)

  # Every dotfile path, for the same reason — /.git/config survived the
  # mod_rewrite deny and was still serving the repo URL and branch list.
  # .well-known is excluded: AutoSSL renews the certificate through it.
  RedirectMatch 403 "^/\.(?!well-known/)"
</If>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Host fence ────────────────────────────────────────────────────
  # Nested subdomain roots inherit these rules. Stop before any of them
  # run for a host that is not the canonical site.
  RewriteCond %{HTTP_HOST} !^(www\.)?pyramedia\.info$ [NC]
  RewriteRule ^ - [L]

  # ── Seal the old Laravel app (still on disk pending owner sign-off) ──
  # DirectoryIndex hands "/" to index.html, but that only shadows the old
  # front controller — it does not disable it. Verified live before this
  # block existed:
  #   /index.php          302 → /index.php/en
  #   /index.php/en       200, 100 KB — the WHOLE old site, carrying the §2.3
  #                       banned phone number, the §2.2 banned "AI-Powered"
  #                       framing and testimonials, with no noindex
  #   /storage/logs/laravel.log   200 — 10 MB of logs with stack traces
  #   /DEPLOYMENT_INSTRUCTIONS.md 200 — deployment notes referencing creds
  #   /artisan /composer.json /README.md /PORTFOLIO_PROJECTS_DATA.json  200
  # Deleting those files is the owner's call; denying them is not, and it is
  # reversible in one file. Remove this block once public_html is cleaned.
  RewriteRule ^index\.php(/|$) - [F,L]
  RewriteRule ^artisan$ - [F,L]
  RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|vendor|docs|pyramedia_docs)(/|$) - [F,L]
  RewriteRule ^(vite|tailwind|postcss)\.config\.js$ - [F,L]
  RewriteRule ^\.env - [F,L]
  RewriteRule ^\.(git|claude|gitignore) - [F,L]
  RewriteRule ^GIT_COMMIT_MESSAGE\.txt$ - [F,L]
  # The new build ships no .md/.sql/.log/.json/.lock at all — verified — so
  # none of these can shadow a real page.
  RewriteRule \.(md|sql|log|lock|json)$ - [F,L]

  # ── Force HTTPS + canonical non-www (single 301) ─────────────────
  # The target host is HARDCODED — building it from HTTP_HOST would let a
  # hostile Host header steer the redirect (flagged pre-GATE 3). Only www
  # and plain-HTTP reach this now; every other host left above.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://pyramedia.info%{REQUEST_URI} [R=301,L]

  # ── Legacy URL map (SPEC §5.1) — old indexed URLs must not 404 ───
  RewriteRule ^en/?$ / [R=301,L]
  RewriteRule ^en/about/?$ /about [R=301,L]
  RewriteRule ^en/services/advanced-search-engine-optimization/?$ /services/seo [R=301,L]
  RewriteRule ^en/services/digital-marketing/?$ /services [R=301,L]
  RewriteRule ^en/services/targeted-social-media-marketing/?$ /services/social-media [R=301,L]
  RewriteRule ^en/services/marketing-automation/?$ /services/ai-solutions [R=301,L]
  RewriteRule ^en/services/high-converting-ppc-advertising/?$ /services/performance-ads [R=301,L]
  RewriteRule ^en/services/brand-strategy/?$ /services/branding [R=301,L]
  RewriteRule ^en/services/?$ /services [R=301,L]
  RewriteRule ^en/contact/?$ /contact [R=301,L]
  RewriteRule ^en/privacy-policy/?$ /privacy [R=301,L]
  RewriteRule ^en/terms-and-conditions/?$ /terms [R=301,L]
  RewriteRule ^en/portfolio(/.*)?$ / [R=301,L]
  RewriteRule ^en/blog(/.*)?$ / [R=301,L]
  RewriteRule ^en/testimonials/?$ / [R=301,L]
  RewriteRule ^en/faq/?$ / [R=301,L]
  RewriteRule ^language/ar/?$ /ar/ [R=301,L]

  # ── Arabic home: canonical /ar/ (serve ar.html) ──────────────────
  RewriteRule ^ar$ /ar/ [R=301,L]
  RewriteRule ^ar/$ ar.html [L]

  # ── Strip trailing slashes from page URLs (canonical form, SPEC §5)
  # NO !-d here. The build emits a page and a folder under the same name —
  # services.html beside services/, in both languages. With !-d, /services/
  # was left to mod_dir, which has no index there. The .html twin wins.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ── Extensionless URLs → prebuilt .html files ────────────────────
  # Also no !-d, for the same collision: /services must resolve to
  # services.html, not bounce off mod_dir's DirectorySlash into /services/.
  # The .html existence check keeps this from touching real directories.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ── Compression ────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ── Caching: hashed /_astro/* assets are immutable; HTML stays fresh
# Every Header below is gated on env=MAINSITE. Without it a nested subdomain
# would inherit this site's cache policy and, far worse, its CSP — which is
# tight enough to break someone else's app.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=MAINSITE
  </FilesMatch>
  <FilesMatch "\.(png|svg|jpe?g|ico)$">
    Header set Cache-Control "public, max-age=604800" env=MAINSITE
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate" env=MAINSITE
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600" env=MAINSITE
  </FilesMatch>

  # ── Security headers (SPEC §13.2) ────────────────────────────────
  Header set X-Content-Type-Options "nosniff" env=MAINSITE
  Header set X-Frame-Options "SAMEORIGIN" env=MAINSITE
  Header set Referrer-Policy "strict-origin-when-cross-origin" env=MAINSITE
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()" env=MAINSITE
  # Conservative CSP compatible with GA4 + Meta Pixel + TikTok Pixel via
  # Partytown (same-origin worker), the n8n webhook (connect-src https:),
  # the click-to-load Google Maps facade (frame-src) and the click-to-load
  # official Instagram reel embeds (script-src + frame-src, Addendum A.1).
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com https://www.instagram.com; worker-src 'self' blob:; connect-src 'self' https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'self' https://www.google.com https://maps.google.com https://www.instagram.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" env=MAINSITE
</IfModule>
