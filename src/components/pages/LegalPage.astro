---
/**
 * Legal page template (SPEC §7.5) — sober, short, factual. The contact
 * email renders from site.ts below the MDX body (single source of truth).
 */
import { getEntry, render } from 'astro:content';
import type { Lang } from '@/config/site';
import { SITE, MAILTO_LINK, licenseLine } from '@/config/site';
import { useTranslations } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
  page: 'privacy' | 'terms';
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);

const entry = await getEntry('legal', `${lang}/${page}`);
if (!entry) throw new Error(`Missing legal content: ${lang}/${page}`);
const { Content } = await render(entry);

---

<BaseLayout lang={lang} title={entry.data.metaTitle} description={entry.data.metaDescription}>
  <section class="mx-auto max-w-3xl px-5 pb-24 pt-20 md:pt-28">
    <h1
      class="font-display font-bold text-text"
      style="font-size: var(--text-h2);"
    >
      {entry.data.title}
    </h1>
    <p class="mt-3 text-sm text-muted">
      {t.legal.updated}: <time datetime={entry.data.lastUpdated} class="ltr-isolate">{entry.data.lastUpdated}</time>
    </p>

    {
      page === 'terms' && (
        <div class="mt-6 text-sm text-muted">
          <p>{t.legal.operator}</p>
          <p class="mt-2 ltr-isolate" dir="ltr">{SITE.legalName}</p>
        </div>
      )
    }

    <div class="legal-prose mt-10">
      <Content />
    </div>

    <div class="mt-12 rounded-xl border border-line bg-surface p-6">
      <p class="text-sm text-muted">
        {t.legal.contactRequests}:
        <a href={MAILTO_LINK} class="ltr-isolate font-medium text-orange hover:text-orange-hot" data-event="email_click" data-placement="legal">
          {SITE.email}
        </a>
      </p>
      <p class="mt-2 text-xs text-muted">{licenseLine(lang)}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
    margin-block: 2.25rem 0.75rem;
  }
  :global(html[lang='ar']) .legal-prose :global(h2) {
    font-family: var(--font-arabic);
    font-weight: 800;
  }
  .legal-prose :global(p) {
    color: var(--color-muted);
    line-height: 1.85;
    margin-block-end: 1rem;
  }
  .legal-prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
