---
/**
 * Service page template (SPEC §7.3): Hero (name + qualitative promise) →
 * What's included → How it runs → Tools we work with (only when tools are
 * defined — plain text, never logos/badges) → Mini-FAQ → CTA band.
 * JSON-LD: Service + FAQPage + BreadcrumbList.
 */
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '@/config/site';
import { SITE, waLink, showcaseUrl } from '@/config/site';
import { useTranslations, localizePath } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import PyramidMark from '@/components/PyramidMark.astro';
import CtaBand from '@/components/CtaBand.astro';

interface Props {
  lang: Lang;
  service: CollectionEntry<'services'>;
}
const { lang, service } = Astro.props;
const t = useTranslations(lang);
const s = service.data;

// Outbound work showcase for this service, when one exists (Addendum A.5).
const showcase = showcaseUrl(s.slug);

const pageUrl = `${SITE.url}${localizePath(`/services/${s.slug}`, lang)}`;
const hubUrl = `${SITE.url}${localizePath('/services', lang)}`;
const homeUrl = `${SITE.url}${localizePath('/', lang)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    description: s.oneLiner,
    url: pageUrl,
    inLanguage: lang,
    areaServed: SITE.areaServed[lang],
    provider: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.nav.home, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: t.nav.services, item: hubUrl },
      { '@type': 'ListItem', position: 3, name: s.name, item: pageUrl },
    ],
  },
];
---

<BaseLayout lang={lang} title={s.metaTitle} description={s.metaDescription} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 glow-orange" aria-hidden="true"></div>
    <PyramidMark
      variant="line"
      class="pointer-events-none absolute -end-32 top-4 hidden w-[36rem] max-w-none opacity-20 lg:block"
    />
    <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-16 md:pt-24" data-reveal-group>
      <nav aria-label={t.a11y.breadcrumb} class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={localizePath('/', lang)} class="hover:text-text">{t.nav.home}</a></li>
          <li aria-hidden="true"><Icon name="arrow-right" size={13} dirAware class="opacity-50" /></li>
          <li><a href={localizePath('/services', lang)} class="hover:text-text">{t.nav.services}</a></li>
          <li aria-hidden="true"><Icon name="arrow-right" size={13} dirAware class="opacity-50" /></li>
          <li aria-current="page" class="text-text/80">{s.name}</li>
        </ol>
      </nav>
      <div class="mt-8 flex items-start gap-5">
        <span class="hidden h-14 w-14 shrink-0 place-items-center rounded-xl border border-line text-orange md:grid">
          <Icon name={s.icon as any} size={28} />
        </span>
        <div>
          <h1
            class="font-display max-w-3xl font-bold text-text"
            style="font-size: clamp(2.1rem, 4.5vw, 4rem); line-height: 1.1;"
          >
            {s.name}
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted" data-reveal>{s.heroPromise}</p>
          <div class="mt-8 flex flex-wrap gap-4" data-reveal>
            <Button href={waLink(lang)} variant="primary" event="whatsapp_click" placement={`service-${s.slug}`}>
              <Icon name="whatsapp" size={18} />
              {t.cta.whatsapp}
            </Button>
            <Button href={localizePath('/contact', lang)} variant="secondary">{t.cta.contactUs}</Button>
            {
              showcase && (
                <Button
                  href={showcase}
                  variant="secondary"
                  event="work_click"
                  placement={`service-${s.slug}`}
                  hreflang="ar"
                >
                  {t.work.viewWork}
                </Button>
              )
            }
          </div>
          {
            showcase && lang === 'en' && (
              <p class="mt-3 text-sm text-muted" data-reveal>
                {t.work.langNote}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="border-t border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-24" data-reveal-group>
      <h2 class="font-display font-bold text-text" style="font-size: var(--text-h2);" data-reveal>
        {t.service.included}
      </h2>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {
          s.deliverables.map((item) => (
            <li class="card flex items-start gap-4 p-6" data-reveal>
              <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-orange/40 text-orange">
                <Icon name="check" size={15} />
              </span>
              <span class="leading-relaxed text-text/90">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How it runs -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:py-24" data-reveal-group>
    <h2 class="font-display font-bold text-text" style="font-size: var(--text-h2);" data-reveal>
      {t.service.process}
    </h2>
    <ol class="mt-10 space-y-0">
      {
        s.processSteps.map((step, i) => (
          <li class="relative flex gap-6 border-s border-line pb-10 ps-8 last:pb-0 md:gap-8" data-reveal>
            <span
              class="font-display absolute -start-5 top-0 grid h-10 w-10 place-items-center rounded-full border border-orange/50 bg-bg text-sm font-bold text-orange"
              dir="ltr"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-1">
              <h3 class="font-display text-xl font-bold text-text">{step.title}</h3>
              <p class="mt-2 max-w-2xl leading-relaxed text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    s.tools && s.tools.length > 0 && (
      <section class="border-y border-line bg-surface/30">
        <div class="mx-auto max-w-6xl px-5 py-16" data-reveal-group>
          <h2 class="eyebrow" data-reveal>
            {t.service.tools}
          </h2>
          {/* Plain text only — never logos or partner badges (SPEC §2.1) */}
          <ul class="mt-6 flex flex-wrap gap-3">
            {s.tools.map((tool) => (
              <li
                class="rounded-full border border-line px-5 py-2 text-sm text-text/85"
                data-reveal
              >
                {tool}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Mini-FAQ -->
  <section class="mx-auto max-w-3xl px-5 py-20 md:py-24" data-reveal-group>
    <h2 class="font-display font-bold text-text" style="font-size: var(--text-h2);" data-reveal>
      {t.service.faq}
    </h2>
    <div class="mt-8 space-y-4">
      {
        s.faq.map((f) => (
          <details class="card group !rounded-2xl p-0 open:border-orange/40" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-semibold text-text [&::-webkit-details-marker]:hidden">
              {f.q}
              <Icon
                name="chevron-down"
                size={18}
                class="shrink-0 text-orange transition-transform duration-300 group-open:rotate-180"
              />
            </summary>
            <p class="px-6 pb-6 leading-relaxed text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaBand lang={lang} placement={`service-${s.slug}-cta`} />
</BaseLayout>
