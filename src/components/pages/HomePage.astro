---
/**
 * Homepage — all seven sections per SPEC §7.1. Rendered by / and /ar/.
 * Copy comes from src/content/pages/{lang}/home.json; the services grid
 * comes from the services collection.
 */
import { Image } from 'astro:assets';
import { getEntry, getCollection } from 'astro:content';
import injazatLogo from '@/assets/clients/injazat-group.png';
import etmamLogo from '@/assets/clients/etmam.png';
import aownLogo from '@/assets/clients/aown.png';
import alAlsonLogo from '@/assets/clients/al-alson.png';
import bellaDenteLogo from '@/assets/clients/bella-dente.png';
import makenLogo from '@/assets/clients/maken-properties.png';
import type { Lang } from '@/config/site';
import { SITE, waLink, showcaseUrl } from '@/config/site';
import { useTranslations, localizePath } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import PyramidMark from '@/components/PyramidMark.astro';
import FounderPanel from '@/components/FounderPanel.astro';
import InstagramReels from '@/components/InstagramReels.astro';
import CtaBand from '@/components/CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const home = await getEntry('pages', `${lang}/home`);
if (!home) throw new Error(`Missing home content for ${lang}`);
const c = home.data as any;

const services = (await getCollection('services', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

// Client logos (Addendum A.6). Owner-supplied files only — each was reduced
// to a single light tone on a shared canvas height so one CSS height renders
// the set at the optical weights baked into the files. A client whose id has
// no logo here still renders, as its approved text name.
const CLIENT_LOGOS: Record<string, ImageMetadata> = {
  'injazat-group': injazatLogo,
  etmam: etmamLogo,
  aown: aownLogo,
  'al-alson': alAlsonLogo,
  'bella-dente': bellaDenteLogo,
  'maken-properties': makenLogo,
};

// Outbound work showcases (Addendum A.5) — links only, no in-site portfolio.
// Each entry disappears on its own if its URL is emptied in site.ts.
const showcases = [
  { href: showcaseUrl('web-development'), label: t.work.web, slug: 'web-development' },
  { href: showcaseUrl('social-media'), label: t.work.video, slug: 'social-media' },
].filter((item) => item.href);

// Client gateway (SPEC Addendum A.3). The owner's intake form is configured
// in site.ts; if that value is ever emptied the door still opens onto the
// §7.4 contact page rather than breaking.
const clientFormHref = SITE.clientFormUrl || localizePath('/contact', lang);
---

<BaseLayout lang={lang} title={c.meta.title} description={c.meta.description} brandDisplay>
  <!-- ───────────────────────── 1 · Hero ───────────────────────── -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 glow-orange" aria-hidden="true"></div>
    <PyramidMark
      variant="line"
      class="hero-pyramid pointer-events-none absolute -end-24 top-10 hidden w-[46rem] max-w-none lg:block"
      data-parallax="0.18"
    />
    <PyramidMark
      variant="line"
      class="pointer-events-none absolute -start-40 -bottom-24 w-[34rem] max-w-none opacity-[0.06]"
      data-parallax="0.08"
    />
    <div class="relative mx-auto max-w-6xl px-5 pb-24 pt-20 md:pb-32 md:pt-28">
      <h1
        class="hero-h1 font-brand max-w-4xl font-bold leading-[1.02] tracking-tight text-text"
        style="font-size: var(--text-h1);"
        dir="ltr"
      >
        <span class="hero-line block overflow-hidden"
          ><span class="hero-line-inner hero-entrance block">{c.hero.h1Line1}</span></span
        >
        <span class="hero-line block overflow-hidden"
          ><span class="hero-line-inner hero-entrance block text-orange">{c.hero.h1Line2}</span></span
        >
      </h1>
      <!-- Paints untouched; entrance motion is on the CTA row -->
      <p class="mt-7 max-w-2xl text-base text-muted md:text-xl">
        {c.hero.sub}
      </p>
      <div class="hero-cta hero-entrance mt-10 flex flex-wrap items-center gap-4">
        <Button href={waLink(lang)} variant="primary" event="whatsapp_click" placement="hero">
          <Icon name="whatsapp" size={18} />
          {t.cta.whatsapp}
        </Button>
      </div>

      <!-- Two doors (SPEC Addendum A.3): hire us, or join us. Gateway pills
           carry their own badge + sheen so they read as a distinct pair
           without out-shouting the WhatsApp primary above. -->
      <div class="hero-gateways hero-entrance mt-5 flex flex-wrap items-center gap-3">
        <Button
          href={clientFormHref}
          variant="gateway"
          arrow={false}
          event="client_apply_click"
          placement="hero"
          class="gateway-a"
        >
          <span class="gateway-badge"><Icon name="target" size={18} /></span>
          {t.cta.becomeClient}
          <Icon name="arrow-up-right" size={15} class="gateway-arrow" dirAware />
        </Button>
        <Button
          href={SITE.careersUrl}
          variant="gateway"
          arrow={false}
          event="careers_click"
          placement="hero"
          class="gateway-b"
        >
          <span class="gateway-badge"><Icon name="send" size={17} /></span>
          {t.cta.careers}
          <Icon name="arrow-up-right" size={15} class="gateway-arrow" dirAware />
        </Button>
      </div>
    </div>
  </section>

  <!-- ─────────────────── 2 · Trusted-by strip ─────────────────── -->
  <section class="border-y border-line bg-surface/30 py-10" aria-label={c.trustedBy.eyebrow}>
    <p class="eyebrow text-center">{c.trustedBy.eyebrow}</p>
    <div class="marquee mt-6" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
      <div class="marquee-track items-center">
        {
          [false, true].map((dup) => (
            <ul class="marquee-list flex shrink-0 items-center" aria-hidden={dup ? 'true' : undefined} data-dup={dup ? 'true' : undefined}>
              {c.trustedBy.clients.map((client: { id: string; name: string }) => (
                <li class="client-logo">
                  {CLIENT_LOGOS[client.id] ? (
                    <Image
                      src={CLIENT_LOGOS[client.id]}
                      alt={dup ? '' : client.name}
                      height={90}
                      densities={[1, 2]}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="text-lg font-medium text-muted md:text-xl">{client.name}</span>
                  )}
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ──────────────────── 3 · Services grid ───────────────────── -->
  <section class="cv-auto mx-auto max-w-6xl px-5 py-24 md:py-32" data-reveal-group>
    <p class="eyebrow" data-reveal>{c.services.eyebrow}</p>
    <h2
      class="font-display mt-3 max-w-2xl font-bold text-text"
      style="font-size: var(--text-h2);"
      data-reveal
    >
      {c.services.title}
    </h2>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <a
            href={localizePath(`/services/${s.data.slug}`, lang)}
            class="card group flex flex-col p-7"
            data-reveal
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl border border-line text-orange transition-transform duration-300 group-hover:-translate-y-1">
              <Icon name={s.data.icon as any} size={24} />
            </span>
            <h3 class="font-display mt-6 text-xl font-bold text-text">{s.data.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.data.oneLiner}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-orange">
              {t.cta.exploreServices}
              <Icon name="arrow-right" size={16} class="card-arrow" />
            </span>
          </a>
        ))
      }
    </div>

    {
      showcases.length > 0 && (
        <div class="mt-12 border-t border-line pt-10" data-reveal>
          <p class="eyebrow">{t.work.eyebrow}</p>
          <div class="mt-5 flex flex-wrap items-center gap-4">
            {showcases.map((item) => (
              <Button
                href={item.href}
                variant="secondary"
                event="work_click"
                placement={`home-${item.slug}`}
                hreflang="ar"
              >
                {item.label}
              </Button>
            ))}
          </div>
          {lang === 'en' && <p class="mt-4 text-sm text-muted">{t.work.langNote}</p>}
        </div>
      )
    }
  </section>

  <!-- ─────────────── 4 · How we work (methodology) ────────────── -->
  <!-- The ONE pinned horizontal-scroll section on the site (SPEC §8). -->
  <section
    id="methodology"
    class="relative overflow-hidden border-y border-line bg-surface/30"
    data-methodology
  >
    <div class="mx-auto max-w-6xl px-5 pt-24 md:pt-28">
      <p class="eyebrow">{c.methodology.eyebrow}</p>
      <h2
        class="font-display mt-3 font-bold text-text"
        style="font-size: var(--text-h2);"
      >
        {c.methodology.title}
      </h2>
    </div>
    <div class="method-viewport mt-12 overflow-x-auto pb-24 md:pb-28" tabindex="0">
      <ol class="method-track flex w-max items-stretch gap-5 px-5 md:gap-8" style="padding-inline-start: max(1.25rem, calc((100vw - 72rem) / 2 + 1.25rem));">
        {
          c.methodology.stages.map((stage: { name: string; blurb: string }, i: number) => (
            <li class="method-stage card flex w-[19rem] shrink-0 flex-col p-7 md:w-[23rem]">
              <span class="stage-num font-display text-5xl font-bold text-orange" aria-hidden="true" dir="ltr">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="font-display mt-5 text-2xl font-bold text-text">{stage.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{stage.blurb}</p>
              <span class="method-progress mt-auto block h-px w-full origin-[var(--flow-origin,left)] bg-orange/60 pt-0" aria-hidden="true" />
            </li>
          ))
        }
      </ol>
    </div>
    <!-- Progress rail: dot + fill track the pinned scrub (decorative) -->
    <div class="method-rail" aria-hidden="true">
      <span class="method-rail-line"></span>
      <span class="method-rail-fill"></span>
      <span class="method-rail-dot"></span>
    </div>
  </section>

  <!-- ──────────────────── 5 · Why PyramediaX ──────────────────── -->
  <section class="cv-auto mx-auto max-w-6xl px-5 py-24 md:py-32" data-reveal-group>
    <p class="eyebrow" data-reveal>{c.why.eyebrow}</p>
    <h2
      class="font-display mt-3 max-w-2xl font-bold text-text"
      style="font-size: var(--text-h2);"
      data-reveal
    >
      {c.why.title}
    </h2>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        c.why.items.map((item: { title: string; body: string }) => (
          <article class="card p-8" data-reveal>
            <h3 class="font-display text-xl font-bold text-text">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ──────────────────── 6 · Founder teaser ──────────────────── -->
  <section class="cv-auto border-t border-line bg-surface/30">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-24 md:grid-cols-2 md:py-32" data-reveal-group>
      <FounderPanel lang={lang} class="max-w-md" data-reveal />
      <div data-reveal>
        <p class="eyebrow">{c.founder.eyebrow}</p>
        <h2
          class="font-display mt-3 font-bold text-text"
          style="font-size: var(--text-h2);"
        >
          {t.founder.name}
        </h2>
        <p class="mt-2 text-lg font-semibold text-orange">{t.founder.title}</p>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">{c.founder.line}</p>
        <div class="mt-8">
          <Button href={localizePath('/about', lang)} variant="secondary">{t.cta.aboutLink}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 6b · Instagram reels (SPEC Addendum A.1, founder-approved) ── -->
  <InstagramReels lang={lang} />

  <!-- ───────────────────── 7 · CTA band ───────────────────────── -->
  <CtaBand lang={lang} placement="home-cta-band" />
</BaseLayout>

<style>
  :global([dir='rtl']) .method-progress {
    --flow-origin: right;
  }
</style>
