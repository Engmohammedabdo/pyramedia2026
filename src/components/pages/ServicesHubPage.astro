---
/** Services hub (SPEC §7.3): intro line + six larger service cards + CTA band. */
import { getEntry, getCollection } from 'astro:content';
import type { Lang } from '@/config/site';
import { useTranslations, localizePath } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const page = await getEntry('pages', `${lang}/services`);
if (!page) throw new Error(`Missing services hub content for ${lang}`);
const c = page.data as any;

const services = (await getCollection('services', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout lang={lang} title={c.meta.title} description={c.meta.description}>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 glow-orange" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-20 md:pt-28">
      <p class="eyebrow" data-reveal>{c.hero.eyebrow}</p>
      <h1
        class="font-display mt-3 max-w-3xl font-bold text-text"
        style="font-size: var(--text-h1);"
      >
        {c.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted" data-reveal>{c.hero.intro}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 md:pb-32" data-reveal-group>
    <div class="grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <a
            href={localizePath(`/services/${s.data.slug}`, lang)}
            class="card group flex flex-col p-9"
            data-reveal
          >
            <span class="grid h-14 w-14 place-items-center rounded-xl border border-line text-orange transition-transform duration-300 group-hover:-translate-y-1">
              <Icon name={s.data.icon as any} size={28} />
            </span>
            <h2 class="font-display mt-7 text-2xl font-bold text-text">{s.data.name}</h2>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{s.data.oneLiner}</p>
            <span class="mt-7 inline-flex items-center gap-2 font-semibold text-orange">
              {t.cta.exploreServices}
              <Icon name="arrow-right" size={18} class="card-arrow" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand lang={lang} placement="services-hub-cta" />
</BaseLayout>
