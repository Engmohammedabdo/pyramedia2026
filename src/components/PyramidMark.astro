---
/**
 * The pyramid mark — two orange peaks from the logo (SPEC §6.3).
 * variant "logo"  → small filled mark for the nav lockup.
 * variant "line"  → stroke-only line-art for hero draw-in / backgrounds
 *                   (paths carry .pyramid-path for GSAP stroke animation).
 */
interface Props {
  variant?: 'logo' | 'line';
  class?: string;
}
const { variant = 'logo', class: className = '' } = Astro.props;
---

{
  variant === 'logo' ? (
    <svg viewBox="0 0 48 32" class={className} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 30 L19 5 L30.5 24 L27 30 Z" fill="var(--color-orange)" />
      <path d="M27 30 L35 16 L44 30 Z" fill="var(--color-orange-hot)" opacity="0.85" />
    </svg>
  ) : (
    <svg
      viewBox="0 0 480 320"
      class={className}
      fill="none"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        class="pyramid-path"
        d="M40 300 L190 50 L305 240"
        stroke="var(--color-orange)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        class="pyramid-path"
        d="M270 300 L350 160 L440 300"
        stroke="var(--color-orange-hot)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.85"
      />
      <path
        class="pyramid-path"
        d="M40 300 L440 300"
        stroke="var(--color-gold)"
        stroke-width="1.5"
        stroke-linecap="round"
        opacity="0.6"
      />
    </svg>
  )
}
