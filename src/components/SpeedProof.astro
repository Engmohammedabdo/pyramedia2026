---
/**
 * Live page-load proof (Feature 9). The number is read from this visitor's
 * own timing data — it is a measurement, never a stored claim, so §2.1 is
 * satisfied by construction.
 *
 * `<ClientRouter />` is mounted site-wide (see BaseLayout.astro), so most
 * visits to this page are a soft navigation, not a document load. The two
 * navigation kinds are measured differently so the number always describes
 * the page the visitor is actually looking at:
 *   - Hard load: Navigation Timing's loadEventEnd.
 *   - Soft navigation: elapsed time between astro:before-preparation (start
 *     of the transition) and astro:page-load (the new page is ready).
 * When neither source can be trusted, the widget hides itself rather than
 * show a broken or misattributed number.
 *
 * The slot is sized before the number exists, so filling it cannot shift
 * layout (§12). No motion is used: a number appearing is enough.
 */
import type { Lang } from '@/config/site';
import { useTranslations } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="mt-10 rounded-2xl border border-line bg-surface/40 p-6" data-speed-proof>
  <p class="eyebrow">{t.speed.eyebrow}</p>
  <p class="mt-3 text-lg text-text/90">
    {t.speed.label}
    <span
      class="font-display mx-2 font-bold text-orange"
      style="min-block-size: 1.6em; display: inline-block; min-inline-size: 6ch;"
      data-speed-value
      aria-live="polite"
      dir="ltr">—</span
    >
    {t.speed.unit}
  </p>
  <p class="mt-2 text-sm text-muted">{t.speed.measuredNow}</p>
  <p class="mt-1 text-sm font-semibold text-text/80">{t.speed.prompt}</p>
</aside>

<script>
  // Timestamp captured when a soft (client-side) navigation begins, so the
  // widget can measure the transition itself instead of reusing the
  // original hard load's Navigation Timing entry, which would describe the
  // wrong page.
  let navPrepStart: number | null = null;
  document.addEventListener('astro:before-preparation', () => {
    navPrepStart = performance.now();
  });

  // Set while the initial hard load's window "load" listener is still
  // pending. Astro also fires astro:page-load once for the initial load
  // itself, and on a fast page that can happen *after* window "load" has
  // already completed — without this flag, that second call would see
  // readyState 'complete' and navPrepStart still null and wrongly treat it
  // as the soft-nav "missed the start event" case, hiding a page that
  // actually has a real hard-load measurement in flight.
  let awaitingHardLoad = false;

  function paintSpeed() {
    const proof = document.querySelector<HTMLElement>('[data-speed-proof]');
    const slot = proof?.querySelector<HTMLElement>('[data-speed-value]');
    if (!slot || slot.dataset.filled === 'true') return;

    // Browsers coarsen timer resolution (Spectre mitigations), so a
    // genuinely fast page can legitimately measure 0. Only a negative value
    // is invalid.
    const render = (ms: number) => {
      if (slot.dataset.filled === 'true') return;
      slot.textContent = (ms / 1000).toFixed(2);
      slot.dataset.filled = 'true';
    };
    const hide = () => proof?.remove();

    if (navPrepStart !== null) {
      // Soft navigation: the time since astro:before-preparation is a true
      // measurement of how long this page took to appear for this visitor.
      const elapsed = performance.now() - navPrepStart;
      navPrepStart = null;
      awaitingHardLoad = false;
      if (elapsed < 0) hide();
      else render(elapsed);
      return;
    }

    if (awaitingHardLoad) {
      // The hard-load measurement below is already scheduled; nothing more
      // to do until its window "load" listener fires.
      return;
    }

    if (document.readyState !== 'complete') {
      // The original hard load: module scripts always run before the
      // document's own load event, so this is the only point at which the
      // browser's Navigation Timing entry is guaranteed to describe the
      // page we are actually on.
      awaitingHardLoad = true;
      window.addEventListener(
        'load',
        () =>
          requestAnimationFrame(() => {
            awaitingHardLoad = false;
            const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
            if (!nav) {
              hide();
              return;
            }
            // startTime is spec-guaranteed 0 for this entry, so
            // loadEventEnd alone is the honest elapsed figure.
            if (nav.loadEventEnd < 0) hide();
            else render(nav.loadEventEnd);
          }),
        { once: true },
      );
      return;
    }

    // readyState is already 'complete' but astro:before-preparation was
    // never observed: the widget mounted for the first time via a soft
    // navigation that started before this script existed to listen for it.
    // Navigation Timing would describe a different page here, so there is
    // no honest number to show — hide rather than display one.
    hide();
  }

  paintSpeed();
  document.addEventListener('astro:page-load', paintSpeed);
</script>
