---
/**
 * Head meta per page (SPEC §11): unique title/description, canonical,
 * hreflang en/ar pairs + x-default, OpenGraph/Twitter cards, JSON-LD.
 * Site-wide Organization/LocalBusiness/WebSite schema is injected here;
 * page-specific blocks arrive via the jsonLd prop.
 */
import { getCollection } from 'astro:content';
import type { Lang } from '@/config/site';
import { SITE, WA_BASE } from '@/config/site';
import { useTranslations, switchLangPath } from '@/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}
const { lang, title, description, jsonLd = [] } = Astro.props;
const t = useTranslations(lang);

// The six approved services (SPEC §7.3) drive the entity's topical and offer
// graph — this is what answer engines read to enumerate what the agency does.
const services = (await getCollection('services', (entry) => entry.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

/** Normalizes a pathname to its canonical live URL form (SPEC §5).
 *  With build.format 'file' the build-time pathname is e.g. /about.html —
 *  strip the extension so canonicals match the live extensionless URLs. */
function canonicalPath(pathname: string): string {
  let p = pathname.replace(/\.html$/, '');
  if (p === '' || p === '/' || p === '/index') return '/';
  if (p === '/ar' || p === '/ar/') return '/ar/';
  return p.replace(/\/$/, '');
}

const path = canonicalPath(Astro.url.pathname);
const canonical = `${SITE.url}${path === '/' ? '/' : path}`;
const altPath = canonicalPath(switchLangPath(path));
const altUrl = `${SITE.url}${altPath === '/' ? '/' : altPath}`;
const enUrl = lang === 'en' ? canonical : altUrl;
const arUrl = lang === 'ar' ? canonical : altUrl;

const ogImage = `${SITE.url}/og-image.png`;
const ogLocale = lang === 'ar' ? 'ar_AE' : 'en_AE';
const ogLocaleAlt = lang === 'ar' ? 'en_AE' : 'ar_AE';

// Site-wide structured data (SPEC §11). Address uses the §14 placeholder
// area line until the exact office address arrives (TODO_OFFICE_ADDRESS_EN).
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${SITE.url}/#organization`,
  name: SITE.brand,
  legalName: SITE.legalName,
  slogan: SITE.tagline,
  url: `${SITE.url}/`,
  logo: ogImage,
  image: ogImage,
  telephone: SITE.phoneE164,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: lang === 'ar' ? SITE.addressAr : SITE.addressEn,
    addressLocality: SITE.addressLocality[lang],
    addressCountry: SITE.addressCountry,
  },
  areaServed: SITE.areaServed[lang],
  sameAs: [SITE.socials.instagram, SITE.socials.facebook, SITE.socials.linkedin, WA_BASE],
  // Approved §4 facts only — no invented history, size, or credentials.
  founder: { '@id': `${SITE.url}/#founder` },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE.phoneE164,
    email: SITE.email,
    contactType: 'customer service',
    areaServed: SITE.addressCountry,
    availableLanguage: ['en', 'ar'],
  },
  // Topical entity association: exactly the six approved services (§7.3)
  knowsAbout: services.map((service) => service.data.name),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t.footer.services,
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: service.data.name,
        description: service.data.oneLiner,
        url: `${SITE.url}${lang === 'ar' ? '/ar' : ''}/services/${service.data.slug}`,
      },
    })),
  },
};

// Founder entity (SPEC §4: name, role, and the approved strategy line only)
const founderSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#founder`,
  name: t.founder.name,
  jobTitle: t.founder.title,
  worksFor: { '@id': `${SITE.url}/#organization` },
  url: `${SITE.url}${lang === 'ar' ? '/ar' : ''}/about`,
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.brand,
  url: `${SITE.url}/`,
  inLanguage: ['en', 'ar'],
  publisher: { '@id': `${SITE.url}/#organization` },
};

// Per-page node so answer engines bind this URL to the entity and language
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organization` },
  primaryImageOfPage: ogImage,
};

const allJsonLd = [orgSchema, founderSchema, webSiteSchema, webPageSchema, ...jsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="ar" href={arUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#0E0E0F" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.brand} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{allJsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
