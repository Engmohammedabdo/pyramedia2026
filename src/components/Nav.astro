---
/**
 * Sticky dark-glass nav (SPEC §6.4): logo, links, language switcher
 * (EN ⇄ ع — same page in the other language), orange WhatsApp CTA.
 * Mobile: full-screen overlay with staggered link animation.
 */
import type { Lang } from '@/config/site';
import { SITE, waLink } from '@/config/site';
import { useTranslations, localizePath, switchLangPath, normalizePathname } from '@/i18n';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: localizePath('/', lang), label: t.nav.home },
  { href: localizePath('/about', lang), label: t.nav.about },
  { href: localizePath('/services', lang), label: t.nav.services },
  { href: localizePath('/contact', lang), label: t.nav.contact },
];

const currentPath = normalizePathname(Astro.url.pathname);
const switchHref = switchLangPath(currentPath);
const homeHref = localizePath('/', lang);

function isActive(href: string): boolean {
  return currentPath === normalizePathname(href);
}
---

<header
  class="sticky inset-inline-0 top-0 z-50 border-b border-line bg-surface/60 backdrop-blur-lg"
  id="site-nav"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 md:h-[4.5rem]">
    <a href={homeHref} class="shrink-0" aria-label={SITE.brand}>
      <Logo />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label={t.nav.primaryLabel}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="nav-link relative py-1 text-sm font-medium text-muted hover:text-text"
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={switchHref}
        class="grid h-9 w-9 place-items-center rounded-full border border-line text-sm font-semibold text-text hover:border-orange hover:text-orange"
        aria-label={t.nav.langSwitch}
        lang={lang === 'ar' ? 'en' : 'ar'}
        data-lang-switch
      >
        {t.nav.langLabel}
      </a>

      <div class="hidden sm:block">
        <a
          href={waLink(lang)}
          target="_blank"
          rel="noopener"
          class="btn-primary !px-5 !py-2.5 text-sm"
          data-event="whatsapp_click"
          data-placement="nav"
        >
          <Icon name="whatsapp" size={17} />
          {t.cta.whatsapp}
        </a>
      </div>

      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border border-line text-text md:hidden"
        aria-label={t.nav.menuOpen}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
      >
        <span class="menu-icon-open"><Icon name="menu" size={22} /></span>
        <span class="menu-icon-close hidden"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>

</header>

<!-- Mobile full-screen overlay. Lives OUTSIDE <header>: its backdrop-blur
     creates a containing block that would trap this fixed element. -->
<div
  id="mobile-menu"
  class="fixed inset-0 top-16 z-40 hidden flex-col justify-between bg-bg/97 px-6 pb-10 pt-10 backdrop-blur-xl md:hidden!"
>
    <nav class="flex flex-col gap-2" aria-label={t.nav.mobileLabel}>
      {
        links.map((link, i) => (
          <a
            href={link.href}
            class="menu-item font-display border-b border-line py-4 text-3xl font-bold text-text"
            style={`transition-delay: ${80 + i * 70}ms`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="menu-item" style="transition-delay: 400ms">
      <a
        href={waLink(lang)}
        target="_blank"
        rel="noopener"
        class="btn-primary w-full justify-center"
        data-event="whatsapp_click"
        data-placement="mobile-menu"
      >
        <Icon name="whatsapp" size={18} />
        {t.cta.whatsapp}
      </a>
    </div>
</div>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    inset-block-end: -2px;
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: 2px;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: var(--underline-origin, left);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global([dir='rtl']) .nav-link::after {
    --underline-origin: right;
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Staggered overlay links */
  #mobile-menu .menu-item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.4s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #mobile-menu.menu-open .menu-item {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu .menu-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean, restoreFocus = false) => {
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      toggle.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
      // Focus contract (G2-RR-006): entering the overlay moves focus to its
      // first link; closing it hands focus back to the toggle on request.
      if (open) {
        menu.querySelector<HTMLElement>('a')?.focus();
      } else if (restoreFocus) {
        toggle.focus();
      }
      // next frame so the transition runs
      requestAnimationFrame(() => menu.classList.toggle('menu-open', open));
    };

    toggle.addEventListener('click', () => {
      setOpen(!isOpen());
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    // Keydown handlers live on document, which survives View Transition
    // swaps — replace instead of stacking one per navigation.
    const w = window as typeof window & {
      __pyxNavEsc?: (e: KeyboardEvent) => void;
      __pyxNavTrap?: (e: KeyboardEvent) => void;
    };
    if (w.__pyxNavEsc) document.removeEventListener('keydown', w.__pyxNavEsc);
    w.__pyxNavEsc = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false, true);
    };
    document.addEventListener('keydown', w.__pyxNavEsc);
    // Focus containment while the full-screen overlay is open (G2-RR-006):
    // Tab cycles through the toggle + overlay links and recaptures focus if
    // it ever lands outside that set.
    if (w.__pyxNavTrap) document.removeEventListener('keydown', w.__pyxNavTrap);
    w.__pyxNavTrap = (e: KeyboardEvent) => {
      if (e.key !== 'Tab' || !isOpen()) return;
      const cycle = [toggle, ...Array.from(menu.querySelectorAll<HTMLElement>('a'))];
      const first = cycle[0];
      const last = cycle[cycle.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (!active || !cycle.includes(active)) {
        e.preventDefault();
        first.focus();
      } else if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    };
    document.addEventListener('keydown', w.__pyxNavTrap);
    // If the viewport crosses the md breakpoint while the overlay is open
    // (e.g. phone rotation), the overlay and toggle become display:none —
    // close the menu so the focus trap never runs against hidden controls.
    const wMedia = window as typeof window & { __pyxNavMedia?: MediaQueryList; __pyxNavMediaCb?: () => void };
    if (wMedia.__pyxNavMedia && wMedia.__pyxNavMediaCb) {
      wMedia.__pyxNavMedia.removeEventListener('change', wMedia.__pyxNavMediaCb);
    }
    wMedia.__pyxNavMedia = window.matchMedia('(min-width: 48rem)');
    // Track continuously whether focus lives in the overlay/toggle: when the
    // breakpoint hides the overlay, the browser drops focus to <body> BEFORE
    // the media-change callback runs, so sampling activeElement there is too
    // late (G2-RR2-003).
    let overlayHadFocus = false;
    const wFocus = window as typeof window & { __pyxNavFocusin?: (e: FocusEvent) => void };
    if (wFocus.__pyxNavFocusin) document.removeEventListener('focusin', wFocus.__pyxNavFocusin);
    wFocus.__pyxNavFocusin = (e: FocusEvent) => {
      const target = e.target as Node | null;
      overlayHadFocus = !!target && (menu.contains(target) || target === toggle);
    };
    document.addEventListener('focusin', wFocus.__pyxNavFocusin);

    wMedia.__pyxNavMediaCb = () => {
      if (!wMedia.__pyxNavMedia?.matches || !isOpen()) return;
      const active = document.activeElement;
      // Hand focus to a visible desktop target when the keyboard user was in
      // the overlay — including the case where the browser already dropped
      // focus to <body> as the overlay became display:none.
      const hadFocus =
        (!!active && (menu.contains(active) || active === toggle)) ||
        (active === document.body && overlayHadFocus);
      setOpen(false);
      if (hadFocus) document.querySelector<HTMLElement>('header nav a')?.focus();
      overlayHadFocus = false;
    };
    wMedia.__pyxNavMedia.addEventListener('change', wMedia.__pyxNavMediaCb);
  }
  document.addEventListener('astro:page-load', initNav);
</script>
