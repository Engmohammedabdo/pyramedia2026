---
/**
 * Base layout — html shell, fonts, head meta, nav/footer, WhatsApp float,
 * consent banner, View Transitions, motion bootstrap.
 */
import { ClientRouter } from 'astro:transitions';
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-500.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/arabic-800.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import cairo400Url from '@fontsource/cairo/files/cairo-arabic-400-normal.woff2?url';
import cairo800Url from '@fontsource/cairo/files/cairo-arabic-800-normal.woff2?url';
import spaceGrotesk700Url from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import inter400Url from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '@/styles/global.css';

import type { Lang } from '@/config/site';
import { useTranslations, dirFor } from '@/i18n';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import Analytics from '@/components/Analytics.astro';
import Seo from '@/components/Seo.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Home hero uses the Space Grotesk brand display; Arabic interiors use Cairo 800. */
  brandDisplay?: boolean;
  /** JSON-LD blocks specific to the page (Service, FAQPage, BreadcrumbList…) */
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, brandDisplay = false, jsonLd = [] } = Astro.props;
const t = useTranslations(lang);
const dir = dirFor(lang);

// Preload the fonts used above the fold. The Arabic homepage keeps the
// English Space Grotesk brand H1 and uses Cairo for its Arabic body copy.
const preloads =
  lang === 'ar'
    ? brandDisplay
      ? [spaceGrotesk700Url, cairo400Url]
      : [cairo800Url, cairo400Url]
    : [spaceGrotesk700Url, inter400Url];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Seo lang={lang} title={title} description={description} jsonLd={jsonLd} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="grain bg-bg">
    <a href="#main" class="skip-link">{t.a11y.skipLink}</a>
    <Nav lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} />
    <ConsentBanner lang={lang} />
    <Analytics />
    <slot name="scripts" />
    <script>
      import '@/scripts/motion-loader';
      import '@/scripts/analytics';
    </script>
  </body>
</html>
